{
  "name": "frontend",
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:e2e": "DETOX_E2E=true expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --fix",
    "test": "jest",
    "test:e2e:ios": "pkill -f 'react-native start' || true && concurrently --kill-others --success first 'DETOX_E2E=true react-native start' 'sleep 10 && DETOX_E2E=true npx detox test --configuration ios.sim.debug'",
    "test:e2e:ios:build": "npx detox build --configuration ios.sim.debug",
    "test:e2e:ios:ci": "detox test --configuration ios.sim.debug --cleanup",
    "test:e2e:ios:ci:with-metro": "concurrently --kill-others --success first 'DETOX_E2E=true react-native start' 'sleep 10 && DETOX_E2E=true detox test --configuration ios.sim.debug --cleanup'",
    "prebuild": "expo prebuild",
    "sync-native": "expo prebuild --no-install",
    "prebuild:clean": "expo prebuild --clean",
    "test:e2e:build": "detox build --configuration ios.sim.debug",
    "test:e2e": "detox test --configuration ios.sim.debug"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.6",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-firebase/app": "^22.2.1",
    "@react-native-firebase/auth": "^22.2.1",
    "@react-native-firebase/crashlytics": "^23.7.0",
    "@react-native-firebase/dynamic-links": "^22.2.1",
    "@react-native-firebase/firestore": "^22.4.0",
    "@react-native-firebase/perf": "^23.7.0",
    "@react-native-google-signin/google-signin": "^11.0.1",
    "@react-navigation/elements": "^1.3.30",
    "@react-navigation/native-stack": "^6.9.26",
    "@types/tinycolor2": "^1.4.6",
    "agora-react-native-rtm": "^1.5.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^10.0.0",
    "expo": "~50.0.0",
    "expo-asset": "~9.0.2",
    "expo-av": "~13.10.6",
    "expo-blur": "~12.9.2",
    "expo-build-properties": "~0.11.1",
    "expo-constants": "~15.4.6",
    "expo-font": "~11.10.3",
    "expo-haptics": "~12.8.1",
    "expo-image": "~1.10.6",
    "expo-linking": "~6.2.2",
    "expo-router": "~3.4.8",
    "expo-splash-screen": "~0.26.5",
    "expo-status-bar": "~1.11.1",
    "expo-symbols": "~0.1.0",
    "expo-system-ui": "~2.9.4",
    "expo-web-browser": "~12.8.2",
    "lodash.get": "^4.4.2",
    "lodash.isempty": "^4.4.0",
    "native-base": "^3.4.28",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-agora": "^4.5.3",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.19.6",
    "react-native-webview": "13.6.4",
    "tinycolor2": "^1.6.0",
    "zustand": "^5.0.6"
